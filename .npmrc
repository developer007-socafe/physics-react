# Project-scoped npm config.
#
# The user-level ~/.npmrc sets `allow-scripts=opencode-ai`, which npm treats as
# the only entry and then rejects when a tool runs `npm install -- <pkg>` inside
# a project (shadcn's CLI does exactly this). Declaring the list here scopes an
# allowlist to this project so nested installs succeed.
#
# Only native build steps that npm would otherwise block are listed. Everything
# else in the dependency tree runs without postinstall scripts.
allow-scripts[]=esbuild
allow-scripts[]=@tailwindcss/oxide
allow-scripts[]=unrs-resolver
allow-scripts[]=lightningcss
# shadcn's CLI shells out to `npm install -- <pkg> --allow-scripts=...`. npm reads
# that flag from the "cli" policy layer, which outranks project .npmrc and
# package.json and is therefore rejected outright in a project-scoped install.
# Clearing it here leaves the .npmrc allowlist above as the effective policy, so
# shadcn's nested install behaves like any other.
allow-scripts=
